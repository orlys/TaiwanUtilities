<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 資料庫管理 Target -->

  <PropertyGroup>
    <DatabasePath>$(MSBuildProjectDirectory)\Postal\zipcode.db</DatabasePath>
    <ReleaseTag>database-latest</ReleaseTag>
    <RepoOwner>orlys</RepoOwner>
    <RepoName>TaiwanUtilities</RepoName>
  </PropertyGroup>

  <!-- 在編譯前確保資料庫存在（只在第一次建置時執行，避免多目標框架重複執行） -->
  <Target Name="EnsureDatabaseExists"
          BeforeTargets="BeforeBuild"
          Condition="'$(TargetFramework)' == '' OR '$(TargetFramework)' == 'netstandard2.0'">
    <Message Importance="high" Text="檢查資料庫: $(DatabasePath)" />

    <!-- 檢查檔案是否存在 -->
    <PropertyGroup>
      <DatabaseExists Condition="Exists('$(DatabasePath)')">true</DatabaseExists>
      <DatabaseExists Condition="!Exists('$(DatabasePath)')">false</DatabaseExists>
    </PropertyGroup>

    <!-- 如果資料庫不存在，嘗試下載 -->
    <Message
      Condition="'$(DatabaseExists)' == 'false'"
      Importance="high"
      Text="========================================%0A資料庫不存在，嘗試自動下載...%0A========================================"
    />

    <!-- 策略 1: 優先使用 GitHub CLI (支援私有 repo) -->
    <Exec
      Condition="'$(DatabaseExists)' == 'false'"
      Command="gh release download $(ReleaseTag) --pattern &quot;zipcode.db&quot; --dir &quot;$(MSBuildProjectDirectory)&quot; --repo $(RepoOwner)/$(RepoName) --clobber"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      ContinueOnError="true"
      IgnoreExitCode="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="GhDownloadExitCode" />
    </Exec>

    <!-- 策略 2: 如果 gh 失敗，嘗試從 Release URL 直接下載（僅適用於公開 repo） -->
    <PropertyGroup>
      <DirectDownloadUrl>https://github.com/$(RepoOwner)/$(RepoName)/releases/download/$(ReleaseTag)/zipcode.db</DirectDownloadUrl>
    </PropertyGroup>

    <!-- 策略 2a: 優先使用 curl (Windows 10+ 和 Unix 都內建) -->
    <Exec
      Condition="'$(DatabaseExists)' == 'false' AND !Exists('$(DatabasePath)')"
      Command="curl -L -f -o &quot;$(DatabasePath)&quot; &quot;$(DirectDownloadUrl)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      ContinueOnError="true"
      IgnoreExitCode="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="CurlDownloadExitCode" />
    </Exec>

    <!-- 策略 2b: Windows fallback - 使用 PowerShell -->
    <Exec
      Condition="'$(DatabaseExists)' == 'false' AND !Exists('$(DatabasePath)') AND '$(OS)' == 'Windows_NT'"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;try { Write-Host '嘗試使用 PowerShell 下載...'; Invoke-WebRequest -Uri '$(DirectDownloadUrl)' -OutFile '$(DatabasePath)' -UseBasicParsing; Write-Host '✓ 下載成功' } catch { Write-Host '✗ 下載失敗（可能是私有 repository）'; exit 1 }&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      ContinueOnError="true"
      IgnoreExitCode="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="PowerShellDownloadExitCode" />
    </Exec>

    <!-- 策略 2c: Unix fallback - 使用 wget -->
    <Exec
      Condition="'$(DatabaseExists)' == 'false' AND !Exists('$(DatabasePath)') AND '$(OS)' != 'Windows_NT'"
      Command="wget -O &quot;$(DatabasePath)&quot; &quot;$(DirectDownloadUrl)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      ContinueOnError="true"
      IgnoreExitCode="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="WgetDownloadExitCode" />
    </Exec>

    <!-- 再次檢查檔案是否存在 -->
    <PropertyGroup>
      <DatabaseExistsAfterDownload Condition="Exists('$(DatabasePath)')">true</DatabaseExistsAfterDownload>
      <DatabaseExistsAfterDownload Condition="!Exists('$(DatabasePath)')">false</DatabaseExistsAfterDownload>
    </PropertyGroup>

    <!-- 顯示結果 -->
    <Message
      Condition="'$(DatabaseExistsAfterDownload)' == 'true'"
      Importance="high"
      Text="✓ 資料庫準備就緒: $(DatabasePath)"
    />

    <Warning
      Condition="'$(DatabaseExistsAfterDownload)' == 'false'"
      Text="⚠️ 資料庫自動下載失敗（可能是私有 repository 或 gh CLI 未安裝）。%0A%0A請使用以下任一方式取得資料庫：%0A%0A【方法 1】使用 GitHub CLI（推薦，支援私有 repo）：%0A  1. 安裝: winget install GitHub.cli%0A  2. 登入: gh auth login%0A  3. 重新建置或執行: gh release download $(ReleaseTag) --pattern &quot;zipcode.db&quot; --dir &quot;$(MSBuildProjectDirectory)&quot; --repo $(RepoOwner)/$(RepoName)%0A%0A【方法 2】手動下載（需登入 GitHub）：%0A  1. 前往: https://github.com/$(RepoOwner)/$(RepoName)/releases/tag/$(ReleaseTag)%0A  2. 下載 zipcode.db%0A  3. 放置於: $(DatabasePath)%0A%0A【方法 3】從原始資料建立（適合開發者）：%0A  1. pwsh tools\Download-PostalDatabase.ps1%0A  2. pwsh tools\Build-PostalDatabase.ps1%0A%0A目前將建置沒有內嵌資料庫的版本。程式執行時會嘗試從 Release 下載（需要認證）。"
    />
  </Target>

  <!-- 將資料庫標記為內嵌資源（如果存在） -->
  <ItemGroup Condition="Exists('$(DatabasePath)')">
    <EmbeddedResource Include="$(DatabasePath)">
      <LogicalName>zipcode.db</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
