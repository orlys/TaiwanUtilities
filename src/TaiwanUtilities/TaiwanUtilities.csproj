<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0;net472</TargetFrameworks>
    <Description>與台灣相關的通用邏輯函式庫</Description>
    <Authors>Orlys</Authors>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <RootNamespace>TaiwanUtilities</RootNamespace>
    <Product>TaiwanUtilities</Product>
    <Copyright>Copyright © $([System.DateTime]::UtcNow.ToString(yyyy)) Orlys Ma. All Rights Reserved.</Copyright>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <RepositoryType>git</RepositoryType>
    <NoWarn>CS1591;CS1685;CS0618;CS1574;CS1571;CS1573;CS8632</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugSymbols>true</DebugSymbols>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>preview</LangVersion>

    <!-- Source Link Settings-->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Pack Settings -->
  <PropertyGroup>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Taiwan,ChineseNumeric,InternationalNumericFormatter,RocDateTime,Validator</PackageTags>
    <PackageVersion>1.0.22</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Link="readme.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition=" $(TargetFramework) == 'net472' ">
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="System.Text.Json" Version="8.*" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.*" />
    <PackageReference Include="System.Collections.Immutable" Version="8.*" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="*" />
    <PackageReference Include="System.Net.Http" Version="4.*" />
    <PackageReference Include="Polyfill" Version="8.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition=" $(TargetFramework) == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.*" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.*" />
    <PackageReference Include="System.Collections.Immutable" Version="8.*" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="*" />
    <PackageReference Include="Polyfill" Version="8.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Holiday -->
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
    <Compile Update="RocDateTime\RocDateTime.Holidays.g.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RocDateTime.Holidays.tt</DependentUpon>
    </Compile>
    <None Update="RocDateTime\RocDateTime.Holidays.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>RocDateTime.Holidays.g.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Additional Metadata -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>RootNamespace</_Parameter1>
      <_Parameter2>$(RootNamespace)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>Language</_Parameter1>
      <_Parameter2>$(Language)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

