    /// </summary>
    public static RocHolidayDataSet Default { get; } = new();

    private static readonly FrozenDictionary<DateTime, RocHoliday> s_embedded = new Dictionary<DateTime, RocHoliday>
    {
<# foreach (var e in entries) {
    var y = int.Parse(e.date.Substring(0, 4));
    var m = int.Parse(e.date.Substring(4, 2));
    var d = int.Parse(e.date.Substring(6, 2));
    var isHol = e.isHoliday == "true" ? "true" : "false";
    var roleEnum = e.role == "labor" ? "HolidayRole.Labor" : e.role == "soldier" ? "HolidayRole.Soldier" : "HolidayRole.All";
    var desc = e.description.Replace("\\", "\\\\").Replace("\"", "\\\"");
#>
        { new DateTime(<#= y #>, <#= m #>, <#= d #>), new RocHoliday(<#= isHol #>, <#= roleEnum #>, "<#= desc #>") },
<# } #>
    }.ToFrozenDictionary();
}
