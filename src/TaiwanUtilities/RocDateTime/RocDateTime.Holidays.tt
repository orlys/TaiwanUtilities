<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#@ output extension=".g.cs" #>
<#
    // 讀取本地 data/holidays/<YEAR>.csv 產生所有假日 entry
    string dataDir = Path.GetFullPath(Path.Combine(Host.ResolvePath(""), "..", "..", "..", "data", "holidays"));
    List<(string date, string isHoliday, string role, string description)> entries =
        new List<(string date, string isHoliday, string role, string description)>();

    if (Directory.Exists(dataDir))
    {
        foreach (string csvPath in Directory.GetFiles(dataDir, "*.csv").OrderBy(f => f))
        {
            string[] lines = File.ReadAllLines(csvPath, Encoding.UTF8);
            for (int i = 1; i < lines.Length; i++) // skip header
            {
                string line = lines[i];
                if (string.IsNullOrWhiteSpace(line)) continue;

                string[] parts = line.Split(',');
                if (parts.Length < 4) continue;

                string dateStr = parts[0].Trim();
                if (dateStr.Length != 8) continue;

                string isHoliday = parts[1].Trim();
                string role = parts[2].Trim();
                string description = parts[3].Trim();

                entries.Add((dateStr, isHoliday, role, description));
            }
        }
    }

    if (!entries.Any())
    {
        Error("No holiday CSV data found in " + dataDir);
    }
#>
// <auto-generated>
// This code was generated by Text Templating Transformation Toolkit.
// Changes to this file may be overwritten if the code is regenerated.
// </auto-generated>

