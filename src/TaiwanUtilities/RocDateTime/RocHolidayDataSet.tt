<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#@ output extension=".g.cs" #>
<#
    // 讀取本地 data/holidays/<YEAR>.csv，僅產生無法由週末/工作日規則推導的例外 entry
    string dataDir = Path.GetFullPath(Path.Combine(Host.ResolvePath(""), "..", "..", "..", "data", "holidays"));
    List<(string date, string isHoliday, string role, string description)> entries =
        new List<(string date, string isHoliday, string role, string description)>();
    int minYear = int.MaxValue;
    int maxYear = int.MinValue;

    Func<int, int, int, string, string, string, (string isHoliday, string role, string description)> normalize =
        (y, m, d, isHoliday, role, description) =>
        {
            string isHol = isHoliday == "true" ? "true" : "false";
            string roleEnum;

            bool isLaborDay = m == 5 && d == 1;
            bool isSoldierDay = m == 9 && d == 3;
            bool isTeacherDay = m == 9 && d == 28 && y >= 2025;
            if (isLaborDay || isSoldierDay || isTeacherDay)
            {
                isHol = "true";
            }

            // 2025 年《紀念日及節日實施條例》修法後，勞動節與教師節改為全國放假
            if (isLaborDay)
                roleEnum = y >= 2025 ? "HolidayRole.All" : "HolidayRole.Labor";
            else if (isSoldierDay)
                roleEnum = "HolidayRole.Soldier";
            else if (isTeacherDay)
                roleEnum = "HolidayRole.All";
            else if (isHol != "true")
                roleEnum = "HolidayRole.None";
            else if (role == "labor")
                roleEnum = "HolidayRole.Labor";
            else if (role == "soldier")
                roleEnum = "HolidayRole.Soldier";
            else if (role == "teacher")
                roleEnum = "HolidayRole.Teacher";
            else
                roleEnum = "HolidayRole.All";

            return (isHol, roleEnum, description);
        };

    Func<int, int, int, (string isHoliday, string role, string description)> derive =
        (y, m, d) =>
        {
            DateTime date = new DateTime(y, m, d);
            if (date.DayOfWeek == DayOfWeek.Saturday)
                return ("true", "HolidayRole.All", "週六");
            if (date.DayOfWeek == DayOfWeek.Sunday)
                return ("true", "HolidayRole.All", "週日");
            return ("false", "HolidayRole.None", "工作日");
        };

    if (Directory.Exists(dataDir))
    {
        foreach (string csvPath in Directory.GetFiles(dataDir, "*.csv").OrderBy(f => f))
        {
            string[] lines = File.ReadAllLines(csvPath, Encoding.UTF8);
            for (int i = 1; i < lines.Length; i++) // skip header
            {
                string line = lines[i];
                if (string.IsNullOrWhiteSpace(line)) continue;

                string[] parts = line.Split(',');
                if (parts.Length < 4) continue;

                string dateStr = parts[0].Trim();
                if (dateStr.Length != 8) continue;

                string isHoliday = parts[1].Trim();
                string role = parts[2].Trim();
                string description = parts[3].Trim();

                int y = int.Parse(dateStr.Substring(0, 4));
                int m = int.Parse(dateStr.Substring(4, 2));
                int d = int.Parse(dateStr.Substring(6, 2));
                if (y < minYear) minYear = y;
                if (y > maxYear) maxYear = y;

                var actual = normalize(y, m, d, isHoliday, role, description);
                var inferred = derive(y, m, d);
                if (actual.isHoliday != inferred.isHoliday ||
                    actual.role != inferred.role ||
                    actual.description != inferred.description)
                {
                    entries.Add((dateStr, actual.isHoliday, actual.role, actual.description));
                }
            }
        }
    }

    if (!entries.Any())
    {
        Error("No holiday CSV data found in " + dataDir);
    }
#>
// <auto-generated>
// This code was generated by Text Templating Transformation Toolkit.
// Changes to this file may be overwritten if the code is regenerated.
// </auto-generated>

namespace TaiwanUtilities;

using System;
