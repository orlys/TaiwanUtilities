<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<#@ output extension=".g.cs" #>
<#
    // 讀取本地 data/holidays/<YEAR>.csv 產生所有假日 entry
    string dataDir = Path.GetFullPath(Path.Combine(Host.ResolvePath(""), "..", "..", "..", "data", "holidays"));
    List<(string date, string isHoliday, string role, string description)> entries =
        new List<(string date, string isHoliday, string role, string description)>();

    if (Directory.Exists(dataDir))
    {
        foreach (string csvPath in Directory.GetFiles(dataDir, "*.csv").OrderBy(f => f))
        {
            string[] lines = File.ReadAllLines(csvPath, Encoding.UTF8);
            for (int i = 1; i < lines.Length; i++) // skip header
            {
                string line = lines[i];
                if (string.IsNullOrWhiteSpace(line)) continue;

                string[] parts = line.Split(',');
                if (parts.Length < 4) continue;

                string dateStr = parts[0].Trim();
                if (dateStr.Length != 8) continue;

                string isHoliday = parts[1].Trim();
                string role = parts[2].Trim();
                string description = parts[3].Trim();

                entries.Add((dateStr, isHoliday, role, description));
            }
        }
    }

    if (!entries.Any())
    {
        Error("No holiday CSV data found in " + dataDir);
    }
#>
// <auto-generated>
// This code was generated by Text Templating Transformation Toolkit.
// Changes to this file may be overwritten if the code is regenerated.
// </auto-generated>

namespace TaiwanUtilities;

using System;
using System.Collections.Frozen;
using System.Collections.Generic;

partial class RocHolidayDataSet
{
    private static readonly FrozenDictionary<DateTime, RocHoliday> s_embedded = new Dictionary<DateTime, RocHoliday>
    {
<# foreach ((string date, string isHoliday, string role, string description) e in entries) {
    int y = int.Parse(e.date.Substring(0, 4));
    int m = int.Parse(e.date.Substring(4, 2));
    int d = int.Parse(e.date.Substring(6, 2));
    string isHol = e.isHoliday == "true" ? "true" : "false";
    // 特殊職業假日：勞動節(5/1)、軍人節(9/3)、教師節(9/28, 2025年起) 無論 CSV 標記都強制為假日
    bool isSpecialRole = (m == 5 && d == 1) || (m == 9 && d == 3) || (m == 9 && d == 28 && y >= 2025);
    if (isSpecialRole)
    {
        isHol = "true";
    }

    string roleEnum;
    if (m == 5 && d == 1)
        roleEnum = "HolidayRole.Labor";
    else if (m == 9 && d == 3)
        roleEnum = "HolidayRole.Soldier";
    else if (m == 9 && d == 28 && y >= 2025)
        roleEnum = "HolidayRole.Teacher";
    else if (isHol != "true")
        roleEnum = "HolidayRole.None";
    else if (e.role == "labor")
        roleEnum = "HolidayRole.Labor";
    else if (e.role == "soldier")
        roleEnum = "HolidayRole.Soldier";
    else if (e.role == "teacher")
        roleEnum = "HolidayRole.Teacher";
    else
        roleEnum = "HolidayRole.All";
    string desc = e.description.Replace("\\", "\\\\").Replace("\"", "\\\"");
#>
        { new DateTime(<#= y #>, <#= m #>, <#= d #>), new RocHoliday(<#= isHol #>, <#= roleEnum #>, "<#= desc #>") },
<# } #>
    }.ToFrozenDictionary();
}
